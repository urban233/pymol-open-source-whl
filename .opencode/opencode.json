{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "agent": {
    "orchestrator": {
      "model": "openai/gpt-5.6-luna",
      "description": "Human-controlled workflow and work-item orchestrator",
      "permission": {
        "bash": {
          "pymake.bat *": "allow",
          "pymake.sh *": "allow"
        }
      }
    },
    "builder": {
      "model": "openai/gpt-5.6-luna",
      "description": "Bounded implementation subagent",
      "permission": {
        "bash": {
          "pymake.bat *": "allow",
          "pymake.sh *": "allow"
        }
      }
    },
    "reviewer": {
      "model": "openai/gpt-5.6-luna",
      "description": "Independent evidence-based code reviewer",
      "permission": {
        "bash": {
          "pymake.bat *": "allow",
          "pymake.sh *": "allow"
        }
      }
    },
    "code-audit": {
      "model": "openai/gpt-5.6-luna",
      "description": "Standalone primary agent for auditing and fixing code style",
      "permission": {
        "bash": {
          "pymake.bat *": "allow",
          "pymake.sh *": "allow"
        }
      }
    }
  }
}
